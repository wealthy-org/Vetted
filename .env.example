# Neon Postgres connection string
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/vetted?sslmode=require

# Required — signs the wallet sign-in nonce and session cookie
# (app/api/auth/*, middleware.js). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/rotating this instantly logs every user out (harmless — they just
# reconnect their wallet). Never share it or commit a real value.
AUTH_SECRET=

# Optional: custom Solana RPC endpoint (defaults to public mainnet-beta if unset)
NEXT_PUBLIC_SOLANA_RPC=

# Secret required in the Authorization header when calling /api/cron/scrape
# and /api/cron/compute-stats: "Authorization: Bearer <this value>".
# These are triggered by an external scheduler (cron-job.org, GitHub
# Actions, etc.) hitting the routes over HTTP — not Vercel Cron.
CRON_SECRET=

# Optional: self-hosted or alternate RSSHub instance (defaults to rsshub.app)
RSSHUB_BASE=

# For scripts/scrape-local.mjs ONLY — a real X account used to log in so
# scraping returns fresh tweets instead of stale/cached guest data.
# Runs on your own machine only, never commit or deploy these.
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=
